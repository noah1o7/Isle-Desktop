<Window x:Class="Isle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Isle"
        Width="404" Height="266"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Display, Segoe UI">

    <Window.Resources>
        <Style x:Key="TabText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="SmallGrey" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- Klickbar ist nur die Insel selbst. Der Rest des Fensters (Schatten, durchsichtiger Rand) lässt
         Klicks durch – das regelt der Code, indem er das Fenster außerhalb der Insel „durchlässig“ schaltet. -->
    <Grid>
        <Grid x:Name="Island"
              HorizontalAlignment="Center" VerticalAlignment="Top"
              Margin="0,3,0,0"
              Width="96" Height="24"
              MouseWheel="Island_MouseWheel"
              SizeChanged="Island_SizeChanged">

            <Rectangle x:Name="IslandBg" Fill="#000000" RadiusX="12" RadiusY="12"
                       Stroke="#14FFFFFF" StrokeThickness="1">
                <Rectangle.Effect>
                    <DropShadowEffect x:Name="Glow" BlurRadius="18" ShadowDepth="3" Direction="270"
                                      Opacity="0.5" Color="#000000"/>
                </Rectangle.Effect>
            </Rectangle>

            <Grid x:Name="IslandContent">

                <!-- ===== Leerlauf ===== -->
                <Grid x:Name="IdlePanel" Opacity="1"/>

                <!-- ===== Kompakt: Cover links, Balken rechts ===== -->
                <Grid x:Name="CompactPanel" Opacity="0" IsHitTestVisible="False" Height="34" VerticalAlignment="Top">
                    <Border x:Name="CompactArt" Width="22" Height="22" CornerRadius="7"
                            HorizontalAlignment="Left" Margin="7,0,0,0" Background="#2C2C2E">
                        <TextBlock x:Name="CompactArtPh" Text="♪" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Path x:Name="CompactMoon" Width="10" Height="10" Stretch="Uniform" Fill="#BF5AF2"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                          Data="M12,3 A6,6 0 0 0 21,12 A9,9 0 1 1 12,3 Z"/>
                    <ContentControl x:Name="CompactBarsHost" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,13,0" Focusable="False"/>
                </Grid>

                <!-- ===== Peek: kurz nach Titelwechsel oder bei einer Erinnerung ===== -->
                <Grid x:Name="PeekPanel" Opacity="0" IsHitTestVisible="False" Height="40" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PeekArt" Grid.Column="0" Width="28" Height="28" CornerRadius="8"
                            Margin="6,0,10,0" Background="#2C2C2E">
                        <TextBlock x:Name="PeekArtPh" Text="♪" FontSize="13" Foreground="{StaticResource TextSecondary}"
                                   FontFamily="Segoe UI Symbol"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="PeekTitle" Foreground="{StaticResource TextPrimary}" FontSize="12.5"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="PeekArtist" Foreground="{StaticResource TextSecondary}" FontSize="11"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <ContentControl x:Name="PeekBarsHost" Grid.Column="2" VerticalAlignment="Center"
                                    Margin="10,0,14,0" Focusable="False"/>
                </Grid>

                <!-- ===== Aufgeklappt ===== -->
                <Grid x:Name="ExpandedPanel" Opacity="0" IsHitTestVisible="False"
                      Width="316" Height="206" Margin="0,16,0,0"
                      HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>

                    <!-- Kopf: Reiter, Fokus, Schließen -->
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock x:Name="TabMusic" Text="Musik" Style="{StaticResource TabText}"
                                       Foreground="{StaticResource TextPrimary}" MouseLeftButtonUp="TabMusic_Click"/>
                            <TextBlock x:Name="TabDevices" Text="Geräte" Style="{StaticResource TabText}"
                                       Margin="14,0,0,0" MouseLeftButtonUp="TabDevices_Click"/>
                        </StackPanel>

                        <Border x:Name="FocusButton" Width="30" Height="26" HorizontalAlignment="Center"
                                Background="Transparent" Cursor="Hand" CornerRadius="13"
                                MouseLeftButtonUp="Focus_Click" ToolTip="Fokus: keine Song-Hinweise">
                            <Path x:Name="MoonIcon" Width="13" Height="13" Stretch="Uniform"
                                  Fill="{StaticResource TextSecondary}"
                                  Data="M12,3 A6,6 0 0 0 21,12 A9,9 0 1 1 12,3 Z"/>
                        </Border>

                        <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Width="26" Height="26"
                                HorizontalAlignment="Right" Background="#1C1C1E" Click="Close_Click" ToolTip="Schließen">
                            <Path Data="M0,0 L8,8 M0,8 L8,0" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                    </Grid>

                    <!-- Seiten -->
                    <Grid Grid.Row="1" Margin="0,12,0,8">

                        <!-- Musik -->
                        <Grid x:Name="MusicPage">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ExpandedArt" Width="76" Height="76" CornerRadius="12" Background="#2C2C2E"
                                        Cursor="Hand" MouseLeftButtonUp="Art_Click" ToolTip="App öffnen">
                                    <TextBlock x:Name="ExpandedArtPh" Text="♪" FontSize="24" Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,8,0" VerticalAlignment="Top">
                                    <TextBlock x:Name="AppName" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="ExpandedTitle" Text="Nichts wird abgespielt" Margin="0,1,0,0"
                                               Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="ExpandedArtist" FontSize="12.5" Foreground="{StaticResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="-7,4,0,0">
                                        <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Width="32" Height="32"
                                                Click="Prev_Click" ToolTip="Zurück">
                                            <Path Stroke="{StaticResource TextPrimary}" StrokeThickness="1.4" StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M1.5,1 V13 M12,1.5 L4.5,7 L12,12.5 Z"/>
                                        </Button>
                                        <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Width="34" Height="34"
                                                Margin="6,0" Background="#1F1F21" Click="Play_Click">
                                            <Path x:Name="PlayIcon" Fill="{StaticResource TextPrimary}"/>
                                        </Button>
                                        <Button x:Name="NextButton" Style="{StaticResource IconButton}" Width="32" Height="32"
                                                Click="Next_Click" ToolTip="Weiter">
                                            <Path Stroke="{StaticResource TextPrimary}" StrokeThickness="1.4" StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M11.5,1 V13 M1,1.5 L8.5,7 L1,12.5 Z"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <ContentControl x:Name="ExpandedBarsHost" Grid.Column="2" VerticalAlignment="Top"
                                                Margin="0,24,2,0" Focusable="False"/>
                            </Grid>

                            <!-- Fortschritt -->
                            <Grid x:Name="ProgressArea" Grid.Row="1" Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid x:Name="ProgressHit" Background="Transparent" Cursor="Hand"
                                      MouseLeftButtonDown="Progress_MouseDown"
                                      MouseMove="Progress_MouseMove"
                                      MouseLeftButtonUp="Progress_MouseUp">
                                    <Border x:Name="ProgressTrack" Height="3" CornerRadius="1.5" Background="#3A3A3C"
                                            VerticalAlignment="Center"/>
                                    <Border x:Name="ProgressFill" Height="3" CornerRadius="1.5" Background="#F5F5F7"
                                            VerticalAlignment="Center" HorizontalAlignment="Left" Width="0"/>
                                    <Ellipse x:Name="ProgressKnob" Width="9" Height="9" Fill="#F5F5F7"
                                             HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform x:Name="KnobShift" X="-4.5"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,2,0,0">
                                    <TextBlock x:Name="ElapsedText" Text="0:00" Style="{StaticResource SmallGrey}" FontSize="11"
                                               HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="DurationText" Text="0:00" Style="{StaticResource SmallGrey}" FontSize="11"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- Geräte -->
                        <Grid x:Name="DevicesPage" Opacity="0" IsHitTestVisible="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Ausgabe" Style="{StaticResource SmallGrey}" Margin="2,0,0,4"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="DevicesList"/>
                            </ScrollViewer>
                            <Grid Grid.Row="2" Height="30" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Width="30" Height="30"
                                        Click="Mute_Click" ToolTip="Stumm schalten">
                                    <Path x:Name="VolumeIcon" Stroke="{StaticResource TextPrimary}" Fill="{StaticResource TextPrimary}"
                                          StrokeThickness="1.3" StrokeLineJoin="Round" Width="16" Height="13" Stretch="Uniform"/>
                                </Button>
                                <Grid x:Name="VolumeHit" Grid.Column="1" Margin="8,0" Height="18" Background="Transparent" Cursor="Hand"
                                      MouseLeftButtonDown="Volume_MouseDown" MouseMove="Volume_MouseMove" MouseLeftButtonUp="Volume_MouseUp">
                                    <Border x:Name="VolumeTrack" Height="4" CornerRadius="2" Background="#3A3A3C" VerticalAlignment="Center"/>
                                    <Border x:Name="VolumeFill" Height="4" CornerRadius="2" Background="#F5F5F7"
                                            VerticalAlignment="Center" HorizontalAlignment="Left" Width="0"/>
                                </Grid>
                                <TextBlock x:Name="VolumeText" Grid.Column="2" Style="{StaticResource SmallGrey}"
                                           HorizontalAlignment="Right" Text="–"/>
                            </Grid>
                        </Grid>

                        <!-- Erinnerungen -->
                        <Grid x:Name="RemindersPage" Opacity="0" IsHitTestVisible="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="RemindersList"/>
                            </ScrollViewer>
                            <TextBlock x:Name="RemindersEmpty" Text="Keine Erinnerungen" Style="{StaticResource SmallGrey}"
                                       HorizontalAlignment="Center" Margin="0,0,0,0"/>
                            <Border Grid.Row="1" Height="32" CornerRadius="9" Background="#1C1C1E" Margin="0,6,0,0"
                                    BorderBrush="#2C2C2E" BorderThickness="1">
                                <Grid Margin="10,0">
                                    <TextBlock x:Name="ReminderPlaceholder" Text="Neue Erinnerung … z. B. 18:30 Wäsche"
                                               Style="{StaticResource SmallGrey}" IsHitTestVisible="False"/>
                                    <TextBox x:Name="ReminderInput" Background="Transparent" BorderThickness="0" FontSize="12"
                                             Foreground="{StaticResource TextPrimary}" CaretBrush="{StaticResource TextPrimary}"
                                             SelectionBrush="{StaticResource Accent}" VerticalAlignment="Center"
                                             PreviewMouseLeftButtonDown="ReminderInput_MouseDown"
                                             TextChanged="ReminderInput_TextChanged" KeyDown="ReminderInput_KeyDown"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Fußzeile -->
                    <Grid Grid.Row="2">
                        <TextBlock x:Name="FooterDate" Style="{StaticResource SmallGrey}" HorizontalAlignment="Left"/>
                        <StackPanel x:Name="PageDots" Orientation="Horizontal" HorizontalAlignment="Center"/>
                        <Button x:Name="RemindersButton" Style="{StaticResource FlatButton}" Height="24" Padding="6,0"
                                HorizontalAlignment="Right" Click="Reminders_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Stroke="{StaticResource TextSecondary}" StrokeThickness="1.3" Width="12" Height="10"
                                      Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"
                                      Data="M0,1 H0.1 M3.5,1 H12 M0,5 H0.1 M3.5,5 H12 M0,9 H0.1 M3.5,9 H12"/>
                                <TextBlock x:Name="RemindersLabel" Text="Erinnerungen" Style="{StaticResource SmallGrey}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
