<Window x:Class="Isle.StartMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Isle Start"
        Width="760" Height="660"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextPrimary}">

    <Window.Resources>
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Width" Value="108"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="12" BorderThickness="1"
                                BorderBrush="Transparent" Padding="6,10,6,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C2C2E"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="selected">
                                <Setter TargetName="Bd" Property="Background" Value="#2C2C2E"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="10,14,0,6"/>
        </Style>
    </Window.Resources>

    <!-- Schatten als eigenes, zwischengespeichertes Element: so muss er nicht bei jedem Hover
         über eine Kachel neu berechnet werden (vorher lag er über dem ganzen Inhalt). -->
    <Grid Margin="24" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="PanelScale" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>
        <Border CornerRadius="20" Background="#1C1C1E">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.6" Color="#000000"/>
            </Border.Effect>
            <Border.CacheMode>
                <BitmapCache/>
            </Border.CacheMode>
        </Border>
    <Border x:Name="Panel" CornerRadius="20" Background="#F51C1C1E"
            BorderBrush="#3A3A3C" BorderThickness="1">

        <Grid Margin="22,22,22,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Suche -->
            <Border Background="#2C2C2E" CornerRadius="12" Height="42" BorderBrush="#3A3A3C" BorderThickness="1">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Width="15" Height="15" Stretch="Uniform" Stroke="{StaticResource TextSecondary}" StrokeThickness="2"
                          Data="M6,0 A6,6 0 1 1 6,12 A6,6 0 1 1 6,0 M10.5,10.5 L15,15" VerticalAlignment="Center"/>
                    <TextBlock x:Name="Placeholder" Grid.Column="1" Margin="12,0,0,0" Text="Apps und Dateien suchen"
                               Foreground="{StaticResource TextSecondary}" FontSize="15" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Margin="10,0,0,0" FontSize="15"
                             Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                             Foreground="{StaticResource TextPrimary}" CaretBrush="{StaticResource TextPrimary}"
                             SelectionBrush="{StaticResource Accent}"
                             TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                </Grid>
            </Border>

            <!-- Inhalt -->
            <ScrollViewer x:Name="Scroller" Grid.Row="1" Margin="-6,6,-10,0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="0,0,8,12">
                    <TextBlock x:Name="RecentHeader" Text="Zuletzt verwendet" Style="{StaticResource SectionHeader}"/>
                    <WrapPanel x:Name="RecentPanel"/>
                    <TextBlock x:Name="AppsHeader" Text="Alle Apps" Style="{StaticResource SectionHeader}"/>
                    <WrapPanel x:Name="AppsPanel"/>
                    <TextBlock x:Name="EmptyText" Text="Nichts gefunden." Foreground="{StaticResource TextSecondary}"
                               Margin="10,6,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Fußzeile -->
            <Border Grid.Row="2" Margin="-22,0,-22,0" Padding="22,10" BorderBrush="#2C2C2E" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,20,20" Background="#0DFFFFFF">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="15">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#5E5CE6" Offset="0"/>
                                    <GradientStop Color="#0A84FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock x:Name="AvatarLetter" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                        </Border>
                        <TextBlock x:Name="UserName" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                    </StackPanel>
                    <Button x:Name="PowerButton" Style="{StaticResource IconButton}" Width="34" Height="34"
                            HorizontalAlignment="Right" Click="Power_Click" ToolTip="Ein/Aus">
                        <Path Stroke="{StaticResource TextPrimary}" StrokeThickness="1.8" Width="15" Height="16" Stretch="Uniform"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M4,3 A7,7 0 1 0 12,3 M8,0 L8,7"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
    </Grid>
</Window>
