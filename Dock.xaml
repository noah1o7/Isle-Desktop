<Window x:Class="Isle.Dock"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Isle Dock"
        Height="160" Width="1200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}">

    <Grid x:Name="Root">
        <!-- Name-Blase über dem Icon unter der Maus -->
        <Canvas IsHitTestVisible="False">
            <Border x:Name="NameBubble" Visibility="Collapsed" Background="#F22C2C2E" CornerRadius="7"
                    BorderBrush="#3A3A3C" BorderThickness="1" Padding="10,4">
                <TextBlock x:Name="NameBubbleText" Foreground="{StaticResource TextPrimary}" FontSize="12.5"/>
            </Border>
        </Canvas>

        <Grid x:Name="DockArea" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"
              Background="#01000000" AllowDrop="True"
              PreviewMouseLeftButtonDown="Area_MouseDown"
              PreviewMouseLeftButtonUp="Area_MouseUp"
              MouseMove="Area_MouseMove"
              MouseLeave="Area_MouseLeave"
              MouseRightButtonUp="Area_RightUp"
              LostMouseCapture="Area_LostCapture"
              DragOver="Area_DragOver"
              Drop="Area_Drop">
            <Border x:Name="DockBg" Height="66" VerticalAlignment="Bottom"
                    Background="#E01C1C1E" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="20"/>
            <StackPanel x:Name="Items" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,8,3"/>
        </Grid>
    </Grid>
</Window>
