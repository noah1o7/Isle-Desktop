<Window x:Class="Isle.TopBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Isle Top-Bar"
        Height="30" Width="1200"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="Transparent"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextHintingMode="Fixed"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{DynamicResource BarFg}">

    <Window.Resources>
        <!-- Farben der Leiste. Werden je nach Helligkeit des Hintergrundbilds umgeschaltet
             (links und rechts getrennt) – siehe ApplyTone im Code. -->
        <SolidColorBrush x:Key="BarFg" Color="#F5F5F7"/>
        <SolidColorBrush x:Key="BarFgDim" Color="#D1D1D6"/>
        <SolidColorBrush x:Key="BarHover" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="BarPressed" Color="#3DFFFFFF"/>

        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource BarFg}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BarHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BarPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Fast unsichtbare Fläche (#01…): ohne sie gingen Klicks auf leere Stellen der Leiste durch sie hindurch -->
    <Grid Background="#01000000">
        <Grid Margin="8,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Links: Isle-Menü und aktive App -->
            <StackPanel x:Name="LeftGroup" Orientation="Horizontal" VerticalAlignment="Stretch"
                        TextElement.Foreground="{DynamicResource BarFg}">
                <StackPanel.Effect>
                    <DropShadowEffect x:Name="LeftHalo" ShadowDepth="0" BlurRadius="7" Opacity="0.5" Color="#000000"/>
                </StackPanel.Effect>
                <Button x:Name="LogoButton" Style="{StaticResource BarButton}" Height="24" Padding="9,0"
                        Click="Logo_Click" ToolTip="Isle-Menü">
                    <Path Fill="{DynamicResource BarFg}" Width="18" Height="9" Stretch="Uniform"
                          Data="F0 M4.5,0 H13.5 A4.5,4.5 0 0 1 13.5,9 H4.5 A4.5,4.5 0 0 1 4.5,0 Z M12,3 A1.5,1.5 0 1 0 12,6 A1.5,1.5 0 1 0 12,3 Z"/>
                </Button>
                <TextBlock x:Name="ActiveApp" Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource BarFg}"
                           MaxWidth="360" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- Rechts: Status -->
            <StackPanel x:Name="RightGroup" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        TextElement.Foreground="{DynamicResource BarFg}">
                <StackPanel.Effect>
                    <DropShadowEffect x:Name="RightHalo" ShadowDepth="0" BlurRadius="7" Opacity="0.5" Color="#000000"/>
                </StackPanel.Effect>
                <Button x:Name="TrayButton" Style="{StaticResource BarButton}" Height="24" Padding="7,0" Margin="0,0,6,0"
                        Click="Tray_Click" ToolTip="Tray-Icons">
                    <Path Stroke="{DynamicResource BarFg}" StrokeThickness="1.5" Width="10" Height="6" Stretch="Uniform"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M0,5 L5,0 L10,5"/>
                </Button>
                <Ellipse x:Name="CamDot" Width="7" Height="7" Fill="#30D158" Margin="0,0,6,0" Visibility="Collapsed"
                         ToolTip="Eine App benutzt die Kamera"/>
                <Ellipse x:Name="MicDot" Width="7" Height="7" Fill="#FF9F0A" Margin="0,0,10,0" Visibility="Collapsed"
                         ToolTip="Eine App benutzt das Mikrofon"/>

                <Button x:Name="WeatherButton" Style="{StaticResource BarButton}" Height="24" Click="Weather_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="WeatherIcon" FontFamily="Segoe UI Symbol" Text="☁" Margin="0,0,5,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="WeatherText" Text="Ort?" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" Margin="6,0" Visibility="Collapsed">
                    <TextBlock x:Name="BatteryText" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"
                               Foreground="{DynamicResource BarFgDim}"/>
                    <Grid VerticalAlignment="Center">
                        <Border Width="23" Height="11" CornerRadius="3" BorderThickness="1" Padding="1.5"
                                BorderBrush="{DynamicResource BarFgDim}">
                            <Border x:Name="BatteryFill" HorizontalAlignment="Left" CornerRadius="1.5"
                                    Background="{DynamicResource BarFg}" Width="10"/>
                        </Border>
                        <TextBlock x:Name="ChargingBolt" Text="⚡" FontFamily="Segoe UI Symbol" FontSize="9"
                                   Foreground="#0C0C0E" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                    <Border Width="2" Height="4" Background="{DynamicResource BarFgDim}" CornerRadius="0,1,1,0"
                            VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="LangText" Margin="8,0" FontSize="12"
                           VerticalAlignment="Center" Foreground="{DynamicResource BarFgDim}"/>

                <Button x:Name="ClockButton" Style="{StaticResource BarButton}" Height="24" Click="Clock_Click"
                        ToolTip="Benachrichtigungen und Kalender">
                    <TextBlock x:Name="ClockText" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Tray-Icons unter dem Pfeil (bleibt immer dunkel) -->
        <Popup x:Name="TrayPopup" PlacementTarget="{Binding ElementName=TrayButton}" Placement="Bottom"
               VerticalOffset="4" HorizontalOffset="-8" AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
            <Border Background="#F21C1C1E" BorderBrush="#3A3A3C" BorderThickness="1" CornerRadius="12"
                    Padding="8" Margin="0,0,10,10" TextElement.Foreground="{StaticResource TextPrimary}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.5" Color="#000000"/>
                </Border.Effect>
                <StackPanel MinWidth="160">
                    <WrapPanel x:Name="TrayIconsPanel" MaxWidth="296"/>
                    <TextBlock x:Name="TrayEmpty" Text="Noch keine Tray-Icons" FontSize="12" Margin="6,4,6,2"
                               Foreground="{StaticResource TextSecondary}" Visibility="Collapsed"/>
                    <Border Height="1" Background="#2C2C2E" Margin="2,8,2,6"/>
                    <Button Style="{StaticResource FlatButton}" Height="26" HorizontalAlignment="Stretch"
                            Click="TrayShowTaskbar_Click">
                        <TextBlock Text="Windows-Taskleiste zeigen" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
